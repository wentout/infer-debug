{
  "name": "infer-debug",
  "version": "0.3.1",
  "description": "Framework-agnostic in-process debug proxy: attach Chrome DevTools to header-marked requests of a running Node.js app via a spawned debug child. Adapters for NestJS, Express, Fastify, or plain http.Server.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "nestjs": [
        "./dist/nestjs.d.ts"
      ],
      "express": [
        "./dist/express.d.ts"
      ],
      "fastify": [
        "./dist/fastify.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "default": "./dist/nestjs.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./package.json": "./package.json"
  },
  "contributors": [
    {
      "name": "wentout",
      "email": "went.out@gmail.com"
    },
    {
      "name": "Kimi AI (k2.6, K2.7, K3)"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wentout/infer-debug.git"
  },
  "bugs": {
    "url": "https://github.com/wentout/infer-debug/issues"
  },
  "homepage": "https://github.com/wentout/infer-debug#readme",
  "keywords": [
    "debug",
    "debugging",
    "nestjs",
    "express",
    "fastify",
    "chrome-devtools",
    "node-inspector",
    "breakpoint",
    "kubernetes",
    "devtools",
    "cdp"
  ],
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "SKILL.md"
  ],
  "bin": {
    "infer-debug": "bin/infer-debug.js",
    "infer-debug-wrap": "bin/infer-debug-wrap.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "jest",
    "build:e2e": "tsc -p e2e/tsconfig.json",
    "test:e2e": "npm run build && npm run build:e2e && jest --config jest.config.e2e.json --runInBand",
    "compose:e2e": "docker compose -f e2e/docker-compose.yaml up --build --abort-on-container-exit --exit-code-from e2e",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "express": "^4.21.0 || ^5.0.0",
    "fastify": "^4.26.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "express": "^4.22.2",
    "fastify": "^5.12.3",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
